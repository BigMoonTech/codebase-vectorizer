# Force LF line endings on POSIX scripts so they keep working when checked
# out on Windows. PowerShell handles LF fine; bash does NOT handle CRLF.
*.sh        text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.ps1       text eol=lf
*.txt       text eol=lf
.gitignore  text eol=lf
LICENSE     text eol=lf
