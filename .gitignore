# Plugin runtime state should never live inside the repo — it goes under
# ${CLAUDE_PLUGIN_DATA} (or the platform fallback). These entries are
# defensive in case someone runs scripts from this directory and the
# fallback resolves here.
python-env/
repos/

# Local git worktrees for isolated feature work.
.worktrees/
